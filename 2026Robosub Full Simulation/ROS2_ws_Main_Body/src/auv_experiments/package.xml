<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auv_experiments</name>
  <version>1.0.0</version>
  <description>RoboSub 实验/评测公共包:任务、编排、记录、指标、绘图、PID 整定、全源码报告</description>
  <maintainer email="liuhao@example.com">liuhao</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>auv_common</exec_depend>
  <exec_depend>auv_controller_pid</exec_depend>
  <exec_depend>auv_controller_gru</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
